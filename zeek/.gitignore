# Keep Zeek .log output (the repo's root .gitignore ignores *.log everywhere)
!*.log

# Zeek runtime state
.state/
spool/
extract_files/
.zeek_history

# Capture files (often large; download them again instead of committing)
*.pcap
*.pcapng
*.cap

# C++ build artifacts
build/
*.o
*.a
*.so
*.out
a.out
