# Zeek logs: only keep notice.log (the other logs can be regenerated from the pcap)
*.log
!notice.log

# Zeek runtime state
.state/
spool/
extract_files/
.zeek_history

# Capture files (often large; download them again instead of committing)
*.pcap
*.pcapng
*.cap

# C++ build artifacts
build/
*.o
*.a
*.so
*.out
a.out
